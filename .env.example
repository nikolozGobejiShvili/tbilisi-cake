# Password for the owner panel at /admin. While this is empty, the panel answers 404.
ADMIN_PASSWORD=

# Where orders and customer photos are stored. On a host, point this at a persistent volume.
DATA_DIR=data

# Public address of the site, used in link previews.
SITE_URL=

# Optional: Telegram message to the owner on each new real order. Empty means no notification.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: limits per visitor, per 10 minutes.
ORDER_RATE_LIMIT=6
UPLOAD_RATE_LIMIT=20

# Only for running a production build over plain http on your own computer.
ALLOW_HTTP_ADMIN=
